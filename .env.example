APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Reports group sales by day in this timezone (default keeps existing data unchanged).
# APP_TIMEZONE=Africa/Lagos

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# Offsite backup (Settings > Backup switches it on and chooses the folder)
# ------------------------------------------------------------------------------
# These fill the "s3" disk in config/filesystems.php, which is a protocol and
# not a supplier: the same four lines work with AWS S3, Backblaze B2, Cloudflare
# R2, Wasabi, DigitalOcean Spaces, or a MinIO box in the back office. The access
# key only needs write and delete on one bucket - never give it an account-wide
# key, and never one that can read your other buckets.
#
# The backup is gzipped and encrypted before it is uploaded, so the bucket does
# not need to be private for the data to be safe - but make it private anyway.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Leave AWS_ENDPOINT empty for Amazon S3 itself. For anyone else, it is the
# S3-compatible endpoint from their dashboard, for example:
#   Backblaze B2       https://s3.us-west-004.backblazeb2.com
#   Cloudflare R2      https://<account-id>.r2.cloudflarestorage.com   (region: auto)
#   Wasabi             https://s3.eu-central-1.wasabisys.com
#   DigitalOcean       https://fra1.digitaloceanspaces.com
#   MinIO (self-run)   http://192.168.1.10:9000  (also set AWS_USE_PATH_STYLE_ENDPOINT=true)
# AWS_ENDPOINT=
# AWS_URL=

VITE_APP_NAME="${APP_NAME}"

# Credentials for the admin created by `php artisan db:seed`. CHANGE THESE outside local dev.
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=test@example.com
SEED_ADMIN_PASSWORD=password

# Set to false on a real shop so seeding never creates the 50 demo products.
# (It is skipped automatically once the catalogue is not empty.)
SEED_DEMO_DATA=true

# Pilot mode (off by default - leave unset for a normal/paid install).
# PILOT_MODE=true
# PILOT_START_DATE=2026-10-20
# PILOT_LENGTH_DAYS=90
# PILOT_WARNING_DAYS=10
# PILOT_LICENSE_KEY=
